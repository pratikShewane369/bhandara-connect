# Copy to server/.env and replace placeholders. Use unique strong values.
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
COOKIE_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=false
APP_TIMEZONE=Asia/Kolkata
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/bhandara_connect?retryWrites=true&w=majority
# Optional; the database name in MONGODB_URI is used when this is omitted.
MONGODB_DB=bhandara_connect
# Configure all six members before running npm run init:members.
MEMBER_1_USERNAME=member1
MEMBER_1_PASSWORD=change-this-example
MEMBER_1_DISPLAY_NAME=Member One
MEMBER_2_USERNAME=member2
MEMBER_2_PASSWORD=change-this-example
MEMBER_2_DISPLAY_NAME=Member Two
MEMBER_3_USERNAME=member3
MEMBER_3_PASSWORD=change-this-example
MEMBER_3_DISPLAY_NAME=Member Three
MEMBER_4_USERNAME=member4
MEMBER_4_PASSWORD=change-this-example
MEMBER_4_DISPLAY_NAME=Member Four
MEMBER_5_USERNAME=member5
MEMBER_5_PASSWORD=change-this-example
MEMBER_5_DISPLAY_NAME=Member Five
MEMBER_6_USERNAME=member6
MEMBER_6_PASSWORD=change-this-example
MEMBER_6_DISPLAY_NAME=Member Six
