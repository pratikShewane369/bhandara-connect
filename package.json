{
  "name": "bhandara-connect",
  "private": true,
  "workspaces": ["client", "server"],
  "scripts": {
    "install:all": "npm install",
    "dev": "concurrently -k \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "init:members": "npm run init:members --workspace server",
    "sync:members": "npm run sync:members --workspace server",
    "test": "npm test --workspace server",
    "build": "npm run build --workspace client"
  },
  "devDependencies": { "concurrently": "^9.1.2" }
}
